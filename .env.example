# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

VITE_AZURE_CLIENT_ID=your-azure-app-client-id
VITE_AZURE_TENANT_ID=your-azure-tenant-id

VITE_SHAREPOINT_SITE_ID=your-sharepoint-site-id
VITE_CHECKLIST_LIST_ID=your-checklist-list-id
VITE_PROGRESS_LIST_ID=your-progress-list-id

# Optional: AI Assistant backend endpoint
VITE_AI_ENDPOINT=
